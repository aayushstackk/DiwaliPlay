<?xml version="1.0" encoding="utf-8"?>
<!--
  The default servers are https. Cleartext stays allowed because the admin screen can point the kiosk at an
  http:// server on the venue LAN, and domain-config can't express "any private address".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
